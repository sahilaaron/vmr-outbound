{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vmr.local/schemas/linkedin-contact-capture/response.json",
  "title": "LinkedIn contact capture — intake response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submission_id",
    "client_submission_id",
    "received_at",
    "already_received",
    "counts",
    "results",
    "operator_workbench_url"
  ],
  "properties": {
    "submission_id": { "type": "string" },
    "client_submission_id": { "type": "string" },
    "received_at": { "type": "string", "format": "date-time" },
    "already_received": {
      "type": "boolean",
      "description": "True when the same client_submission_id and identical content were already accepted; the original outcome is replayed unchanged."
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted",
        "created",
        "refreshed_exact_match",
        "exact_match_unchanged",
        "staged_unmatched",
        "staged_ambiguous",
        "duplicate_in_submission",
        "suppressed",
        "labels_applied",
        "notes_recorded",
        "campaign_filings_applied",
        "campaign_filings_pending",
        "campaign_filings_failed"
      ],
      "properties": {
        "submitted": { "type": "integer", "minimum": 0 },
        "created": {
          "type": "integer",
          "minimum": 0,
          "description": "Permanent Contacts created by this submission. Missing identity or Company fields remain null and keep downstream Agents blocked until they are resolved."
        },
        "refreshed_exact_match": { "type": "integer", "minimum": 0 },
        "exact_match_unchanged": { "type": "integer", "minimum": 0 },
        "staged_unmatched": { "type": "integer", "minimum": 0 },
        "staged_ambiguous": { "type": "integer", "minimum": 0 },
        "duplicate_in_submission": { "type": "integer", "minimum": 0 },
        "suppressed": { "type": "integer", "minimum": 0 },
        "labels_applied": { "type": "integer", "minimum": 0 },
        "notes_recorded": { "type": "integer", "minimum": 0 },
        "campaign_filings_applied": { "type": "integer", "minimum": 0 },
        "campaign_filings_pending": { "type": "integer", "minimum": 0 },
        "campaign_filings_failed": { "type": "integer", "minimum": 0 }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_capture_id", "capture_id", "outcome", "warnings", "capture_url"],
        "properties": {
          "client_capture_id": { "type": "string" },
          "capture_id": { "type": ["string", "null"] },
          "outcome": {
            "enum": [
              "stored",
              "created",
              "exact_match_refreshed",
              "exact_match_unchanged",
              "unmatched_staged",
              "ambiguous_review",
              "duplicate_in_submission",
              "suppressed"
            ]
          },
          "matched_contact_id": { "type": ["string", "null"] },
          "contact_url": { "type": ["string", "null"] },
          "capture_url": { "type": ["string", "null"] },
          "review_candidate_count": { "type": "integer", "minimum": 0 },
          "labels_applied": { "type": "array", "items": { "type": "string" } },
          "campaign_filing": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "requested_campaign_id",
                  "campaign_id",
                  "campaign_contact_id",
                  "attempts",
                  "error_code",
                  "error_detail"
                ],
                "properties": {
                  "status": { "enum": ["pending", "applied", "failed"] },
                  "requested_campaign_id": { "type": "string" },
                  "campaign_id": { "type": ["string", "null"] },
                  "campaign_contact_id": { "type": ["string", "null"] },
                  "attempts": { "type": "integer", "minimum": 0 },
                  "error_code": { "type": ["string", "null"] },
                  "error_detail": { "type": ["string", "null"] }
                }
              }
            ]
          },
          "warnings": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "operator_workbench_url": { "type": ["string", "null"] }
  }
}
