{
  "manifest_version": 3,
  "name": "VM Prospector",
  "version": "2.1.0",
  "description": "VM Prospector — operator-driven acquisition of LinkedIn and Sales Navigator contacts. Saves permanent contacts with optional Campaign filing; no scraping automation or credentials stored.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://www.linkedin.com/sales/*",
    "https://www.linkedin.com/in/*",
    "https://www.linkedin.com/company/*",
    "https://srv1885453.hstgr.cloud/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "VM Prospector"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/sales/*"],
      "js": [
        "src/common/constants.js",
        "src/common/normalize.js",
        "src/common/extraction.js",
        "src/common/scroller.js",
        "src/content/content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": [
        "src/common/constants.js",
        "src/common/normalize.js",
        "src/common/extraction.js",
        "src/common/surface.js",
        "src/common/profile-extraction.js",
        "src/content/profile-content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/company/*"],
      "js": [
        "src/common/constants.js",
        "src/common/normalize.js",
        "src/common/extraction.js",
        "src/common/surface.js",
        "src/common/company-extraction.js",
        "src/content/company-content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
