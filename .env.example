# VMR Outbound Agent — environment variable reference.
#
# Copy to `.env` for local development and fill in local values only.
# NEVER commit a real `.env` or any credential. Production/staging values are
# supplied by the deployment environment or a secret manager, not this file.

# --- Application ---
APP_NAME="VMR Outbound Agent"
# local | ci | staging | production
APP_ENV=local
DEBUG=false
# Deployment-provided build identifier returned by GET /version. Use a release
# tag or immutable image/build ID; the app never shells out to Git at request time.
# RELEASE_ID=unknown

# HTTP boundary. JSON arrays are required for tuple-valued settings.
# Local defaults accept only localhost, loopback and Starlette's test host.
# Staging/production must supply explicit deployed hostnames; wildcard hosts are
# refused. Do not include a scheme or path.
# Port-free Host allow-list. DNS names are case-normalized and may have one
# terminal dot; bracketed IPv6 literals are supported.
# TRUSTED_HOSTS=["localhost","127.0.0.1","[::1]","testserver"]
# Forwarded headers are honored only when the immediate TCP peer is in one of
# these networks. Loopback fits a same-host Nginx deployment; use the actual
# private proxy network when Nginx is remote. Never use 0.0.0.0/0 or ::/0.
# TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
# Global declared request ceiling. Keep at least as large as MAX_UPLOAD_BYTES.
# Complete enforcement, including chunked bodies, belongs in Nginx/Uvicorn.
# MAX_REQUEST_BYTES=26214400
# Emitted only when HTTPS is known directly or from a trusted proxy. Set 0 to
# disable during an HTTPS rollout; default is one year.
# HSTS_MAX_AGE_SECONDS=31536000

# --- Safety switches ---
# Dry-run defaults to true. Only a deliberate, reviewed change may set it false,
# and only in an environment authorized to schedule real email.
DRY_RUN=true

# --- Database ---
# SQLAlchemy URL. Local dev default matches docs/DEVELOPMENT.md.
# Production uses the same variable name, populated from the RDS secret — the
# value below is a non-secret local default and must be overridden in RDS envs.
DATABASE_URL=postgresql+psycopg://dev@127.0.0.1:5433/vmr_dev
# Connection and readiness bounds (seconds). Readiness uses a dedicated,
# short-lived async connection, one concurrent database operation, one absolute
# deadline covering contention and work, a driver connect timeout, and a
# connection-local statement timeout. The application engine separately applies
# DATABASE_CONNECT_TIMEOUT_SECONDS when opening its own pooled connections.
# DATABASE_CONNECT_TIMEOUT_SECONDS=5
# READINESS_TIMEOUT_SECONDS=2

# --- Operator workbench (local) ---
# Server-rendered local UI. Both stay off by default; enable together for
# local operation (see docs/WORKBENCH.md).
# FEATURES__WORKBENCH=false
# Seller-side Knowledge Base (KB-001): the operator-maintained company profile,
# offerings, proof points, restricted claims, personas, and the campaign-to-
# offering association. Off by default; needs FEATURES__WORKBENCH as well,
# because it is part of that UI. While off the pages return 404, the navigation
# entry is absent, and the campaign page renders exactly as before. Turning it
# on records operator knowledge and nothing else: it drafts nothing, calls no
# model, and changes no prospect research (see docs/SELLER_KNOWLEDGE_BASE.md).
# FEATURES__SELLER_KNOWLEDGE_BASE=false
# Workbench Agent monitor and controls (MVP-01B): the operator control room over
# the Phase 2 execution backbone — the Agent registry and controls, Campaign
# execution, Campaign Contact pipeline state, durable Agent Jobs, and the
# operator commands over them. Off by default; needs FEATURES__WORKBENCH as well.
# While off the area renders one clean unavailable state.
# It reads the real Phase 2 services directly: there is no execution-source
# setting and nothing to register (see docs/AGENT_WORKBENCH.md).
# FEATURES__AGENT_WORKBENCH=false
# Staged uploads for the preview -> confirm import flow live on local disk:
# STAGED_UPLOADS_DIR=var/staged_uploads
# Maximum spreadsheet upload size in bytes; oversized files are rejected
# before parsing or staging. Default 26214400 (25 MB).
# MAX_UPLOAD_BYTES=26214400

# --- Sales Navigator capture intake (DAT-009, local only) ---
# Loopback base URL used to build the operator workbench deep link returned to
# the capture extension. Must be a loopback origin.
# OPERATOR_BASE_URL=http://127.0.0.1:8000
# Maximum Sales Navigator intake body size in bytes; oversized bodies are
# rejected with 413 before parsing. Default 2097152 (2 MB).
# SALESNAV_INTAKE_MAX_BYTES=2097152
# Wall-clock budget in seconds for one intake staging operation; on breach the
# staging transaction rolls back and the request returns 504. Default 15.
# SALESNAV_INTAKE_TIMEOUT_SECONDS=15

# --- Contact-first capture intake (DAT-013, local only) ---
# The endpoint the contact-acquisition extension submits to. Off by default.
# When on, one reviewed submission stores permanent per-person capture evidence,
# refreshes a contact ONLY on an exact normalized LinkedIn profile URL, and
# applies operator labels/notes. No campaign is involved at any point, and a
# capture never makes a contact outreach-eligible.
# FEATURES__CONTACT_CAPTURE_INTAKE=false
# Maximum submission body size in bytes (a submission may carry up to 500
# reviewed people with their raw snapshots). Default 8388608 (8 MB).
# CONTACT_CAPTURE_INTAKE_MAX_BYTES=8388608
# Wall-clock budget in seconds for one submission; on breach the whole
# submission rolls back and the request returns 504. Default 60.
# CONTACT_CAPTURE_INTAKE_TIMEOUT_SECONDS=60
# Promotion of a staged capture into a canonical contact (DAT-014). Off by
# default. Needs FEATURES__WORKBENCH for the operator flow, and — to run a
# domain lookup — FEATURES__SALESNAV_DOMAIN_ENRICHMENT plus LOGO_DEV_API_KEY.
# Without a key the flow still works: the operator can enter a domain manually
# or leave the capture pending. No domain is ever invented.
# FEATURES__CONTACT_CAPTURE_PROMOTION=false

# --- Sales Navigator company-domain enrichment (DAT-010, local only) ---
# Off by default. When on, the operator can look up a captured company's domain
# through the official logo.dev Search Brands API and confirm one candidate by
# hand. Nothing is auto-accepted and no domain is invented.
# FEATURES__SALESNAV_DOMAIN_ENRICHMENT=false
# logo.dev Search Brands by Name API key (SECRET). Provide a local value only;
# never commit a real key. When unset, the lookup reports "API not configured".
# LOGO_DEV_API_KEY=
# Optional overrides (defaults are fine for local use):
# LOGO_DEV_SEARCH_URL=https://api.logo.dev/search
# LOGO_DEV_TIMEOUT_SECONDS=10
# LOGO_DEV_MAX_CANDIDATES=10

# --- Feature switches (all default off; enable per phase as built) ---
# Authorized spreadsheet import of contacts into a campaign. Gates BOTH the
# generic mapped importer at /imports and the campaign-bound Apollo contact file
# import at /app/campaigns/{id}/imports (IMP-001, docs/CAMPAIGN_FILE_IMPORT.md).
# While off, both refuse and the customer page says so. It never authorizes a
# provider call: the campaign import path deliberately calls none.
# FEATURES__CSV_IMPORT=false
# Local Sales Navigator capture intake endpoint (DAT-009). Off by default.
# FEATURES__SALESNAV_INTAKE=false
# FEATURES__NORMALIZATION=false
# FEATURES__DEDUPLICATION=false
# FEATURES__SUPPRESSIONS=false
# Phase 2 — Email intelligence + verification. Enable together for the full path:
# generation produces ranked candidates; millionverifier verifies the selected
# exact address. Both default off (FND-007).
# FEATURES__EMAIL_GENERATION=false
# FEATURES__MILLIONVERIFIER=false
# FEATURES__SCORING=false
# FEATURES__INSIGHTS_RESEARCH=false
# FEATURES__CLAUDE_MCP_BRIDGE=false
# FEATURES__DRAFTING=false
# FEATURES__SALESHANDY=false
# Seven-message Personalization sequences (SEQ-001). Off by default, and off
# means unchanged: the Personalization Agent writes exactly the single draft it
# always has, and no sequence row is created on any path.
#
# Turning this on is necessary but not sufficient. A Campaign must also opt in
# through cadence_config, so enabling the deployment flag never silently changes
# what an existing Campaign produces:
#
#   {"sequence": {"enabled": true, "elapsed_days": [0, 3, 7, 12, 18, 25, 35]}}
#
# "elapsed_days" is optional; omitting it uses the bounded default ladder above.
# What "on" adds is one generation unit producing seven immutable messages for
# human review. It creates no Gmail draft, contacts no Google API, schedules
# nothing and sends nothing. See docs/EMAIL_SEQUENCE.md.
# FEATURES__EMAIL_SEQUENCES=false
# Company research through the registered deterministic website worker (RES-001).
# Off by default; a Campaign must additionally set the Research Agent config to
# {"live": true} before any site is read.
# FEATURES__COMPANY_RESEARCH=false
# The Claude CLI web-research fallback inside the Research Agent (RES-002). Off
# by default, and while off the Research Agent behaves exactly as it did before
# it existed. Needs FEATURES__COMPANY_RESEARCH as well, because it is the second
# half of that stage rather than a route of its own. When on, one bounded Claude
# CLI call runs — with web search and webpage reading only — after the
# deterministic worker has already failed or returned too little. It stores no
# claim that lacks an openable source URL and supporting page text, writes no
# canonical Company field, and its evidence stays labelled as Claude-assisted.
# A Campaign may switch it off with the Research Agent config
# {"claude_fallback": false}; a Campaign can never switch it on.
# FEATURES__RESEARCH_CLAUDE_FALLBACK=false

# --- Local Claude CLI seam (Research fallback, Insights, Personalization) ---
# The operator's own `claude` executable, run under their existing subscription.
# No key lives here and no paid API is involved. Defaults are correct for a
# standard install; override only if the CLI is elsewhere or its flags change.
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT_SECONDS=300
# CLAUDE_CLI_WORKING_DIRECTORY=
# CLAUDE_CLI_VERSION_LABEL=claude-cli/v1
# Argument template; the literal token {allowed_tools} is replaced per call and
# drops out entirely when the call permits no tools.
# CLAUDE_CLI_ARGUMENTS=["-p","--output-format","json","{allowed_tools}"]

# --- Research Claude fallback bounds (RES-002) ---
# These decide how far the fallback may go once FEATURES__RESEARCH_CLAUDE_FALLBACK
# allows it to run at all. Conservative defaults shown.
# RESEARCH_CLAUDE_FALLBACK_TIMEOUT_SECONDS=240
# Ceiling on distinct source URLs accepted from one call. Stated to the model as
# its search/fetch budget and enforced on the way back in.
# RESEARCH_CLAUDE_FALLBACK_MAX_SOURCES=8
# RESEARCH_CLAUDE_FALLBACK_MAX_EVIDENCE_ITEMS=20
# Recorded verbatim on every fact, dossier and job result the fallback produces.
# RESEARCH_CLAUDE_FALLBACK_PRODUCER_VERSION=research-claude-fallback/1
# The narrowest permissions that still allow finding and reading pages. Widening
# this is a deliberate act: no shell, no filesystem and no editing tool belongs
# in a research call.
# RESEARCH_CLAUDE_FALLBACK_ALLOWED_TOOLS=["WebSearch","WebFetch"]

# --- MillionVerifier exact-address verification (Phase 2) ---
# The MillionVerifier Single API key (SECRET). Provide a local value only; never
# commit a real key. When unset, verification runs a deterministic, network-free
# simulator and no live call is ever made — the whole pipeline still works. The
# documented test keys (API_KEY_FOR_OK, API_KEY_FOR_CATCH_ALL, …) are recognised
# and also route to the simulator, never to the network.
# MILLIONVERIFIER_API_KEY=
# Optional overrides (defaults are correct for production):
# MILLIONVERIFIER_BASE_URL=https://api.millionverifier.com/api/v3
# MILLIONVERIFIER_TIMEOUT_SECONDS=20
# Retry/backoff, lease, and freshness policy (defaults shown; policy-versioned):
# VERIFICATION_MAX_ATTEMPTS=4
# VERIFICATION_RETRY_BASE_SECONDS=30
# VERIFICATION_RETRY_MAX_SECONDS=1800
# VERIFICATION_LEASE_SECONDS=120
# VERIFICATION_TTL_VALID_DAYS=30
# VERIFICATION_TTL_INVALID_DAYS=90
# VERIFICATION_TTL_CATCH_ALL_DAYS=7
# VERIFICATION_TTL_UNKNOWN_DAYS=3
# VERIFICATION_TTL_DISPOSABLE_DAYS=30
# Local estimated cost per *billed* MillionVerifier credit, for cost visibility
# in the operator usage summary. This is your plan's effective per-email rate, not
# a quote (the Single API does not report a per-call price). Default 0 means "rate
# not configured": the ledger still records credits consumed, and the UI shows
# credits with the cost left explicitly unestimated rather than fabricating one.
# MILLIONVERIFIER_COST_PER_CREDIT=0.0
# MILLIONVERIFIER_CURRENCY=USD
# Fernet key used only to encrypt Admin-managed provider credential versions.
# Generate out of band; never commit the value. Without it credential rotation
# and live Agent Studio tests remain explicitly unavailable.
# PROVIDER_CREDENTIAL_ENCRYPTION_KEY=
# --- Other external providers (names only; NO keys committed) ---
# Populate these in the deployment secret manager when their phase is built.
# SALESHANDY_API_KEY=
