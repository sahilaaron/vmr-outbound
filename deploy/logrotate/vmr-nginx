# Installs to /etc/logrotate.d/vmr-nginx
# VMR staging nginx logs. Separate from the distribution's own nginx policy so
# it is obvious which files belong to VMR.
/var/log/nginx/vmr-staging.*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    su root adm
    sharedscripts
    postrotate
        [ -f /run/nginx.pid ] && kill -USR1 "$(cat /run/nginx.pid)" || true
    endscript
}
