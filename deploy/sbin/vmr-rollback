#!/bin/bash
# vmr-rollback - repoint the active release symlink at a previous release.
#
# CODE ONLY. This script deliberately contains no database logic whatsoever.
# It will never run `alembic downgrade`. See the long note in vmr-deploy for why
# code rollback and schema rollback are not symmetrical operations.
#
#   Usage: vmr-rollback --to <release-dir-name> [--execute]
#          vmr-rollback --list
#
# Exit codes: 0 ok / 1 usage / 2 precondition
set -uo pipefail
RELEASES=/srv/vmr/releases
APPLINK=/srv/vmr/app
TARGET=""; EXECUTE=0
die() { echo "vmr-rollback: ERROR: $2" >&2; exit "$1"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --list) ls -1t "$RELEASES" 2>/dev/null || echo "(no releases)"; exit 0 ;;
    --to) TARGET="${2:-}"; shift 2 ;;
    --execute) EXECUTE=1; shift ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) die 1 "unknown argument '$1'" ;;
  esac
done

[ "$(id -u)" -eq 0 ] || die 2 "must be run as root"
[ -n "$TARGET" ] || die 1 "--to <release-dir-name> is required (see --list)"
[ -d "$RELEASES/$TARGET" ] || die 2 "no such release: $RELEASES/$TARGET"
[ -x "$RELEASES/$TARGET/.venv/bin/python" ] || die 2 "release has no usable venv: $TARGET"

CURRENT=$(readlink -f "$APPLINK" 2>/dev/null || echo "(none)")
echo "vmr-rollback PLAN"
echo "  current : $CURRENT"
echo "  target  : $RELEASES/$TARGET"
echo "  action  : repoint $APPLINK, restart vmr-web then vmr-worker"
echo "  DATABASE SCHEMA IS LEFT UNTOUCHED - this is intentional."

if [ "$EXECUTE" -ne 1 ]; then echo; echo "DRY RUN only. Nothing changed."; exit 0; fi

ln -sfn "$RELEASES/$TARGET" "$APPLINK" || die 2 "could not repoint symlink"
systemctl restart vmr-web    || die 2 "vmr-web restart failed"
systemctl restart vmr-worker || die 2 "vmr-worker restart failed"
echo "vmr-rollback: OK - now serving $RELEASES/$TARGET"
echo "REMINDER: if the failure was caused by a migration, a human must decide"
echo "          what to do about the schema. Do NOT reflexively downgrade."
