# Shape of /etc/vmr/vmr.env on the staging server.
#
# ############################################################################
# THIS FILE DOCUMENTS KEYS AND NON-SECRET OPERATIONAL VALUES ONLY.
# It must NEVER contain a credential. The real file lives ONLY on the server at
# /etc/vmr/vmr.env, mode 0640 root:vmr, and is never committed, copied into the
# repository, or printed.
# ############################################################################
#
# Loaded by the systemd units via EnvironmentFile=, and read (never echoed) by
# /usr/local/sbin/vmr-deploy when it runs migrations.
#
# FORMAT RULE - IMPORTANT
# systemd's EnvironmentFile syntax is more permissive than the shell's: systemd
# accepts `A=b c` unquoted, the shell does not. Because vmr-deploy sources this
# file to run Alembic with the deployed database, every value containing a
# space, quote, or shell metacharacter MUST be single-quoted here. The values
# below are written that way already; keep it that way when you edit the real
# file, or a deployment will fail at the migration step.
#
# Every variable name below was checked against app/core/config.py. A name that
# the application does not read is worse than a missing one: it looks configured
# and silently is not.

# --- Environment ------------------------------------------------------------
# The application reads APP_ENV. It does NOT read VMR_ENV.
#
# This matters more than it looks. Every staging guard in
# app/core/runtime.py - the DEBUG check, the DRY_RUN check, the wildcard and
# local-only TRUSTED_HOSTS checks, the non-loopback DATABASE_URL check, the
# local-only feature check - is keyed on this label being exactly "staging" or
# "production". Name it wrongly and the application starts in "local" mode with
# every one of those protections inert, believing itself hardened.
APP_ENV=staging
DEBUG=false

# --- Safety -----------------------------------------------------------------
# DRY_RUN must stay true. Staging startup refuses false until a send-capable
# deployment is separately approved. This is not a knob to turn during a demo.
DRY_RUN=true

# --- Build identity ---------------------------------------------------------
# DO NOT SET RELEASE_ID HERE.
#
# vmr-deploy writes it per release to /srv/vmr/shared/runtime/release.env, which
# both units load *after* this file, so the deployed Git SHA always wins. Setting
# it here would pin every release to one stale value and make GET /version lie.
# Constraint from app/core/config.py: ^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$ -
# no colon and no slash, so a full 40-character Git SHA is valid and a
# "host:pid" or path-shaped label is rejected at startup.

# --- HTTP boundary ----------------------------------------------------------
# TRUSTED_HOSTS is the Host-header allow-list. It must name the real staging
# hostname: staging startup refuses a wildcard, and refuses a set consisting only
# of {localhost, 127.0.0.1, [::1], testserver}.
#
# REPLACE_WITH_STAGING_DNS_NAME is a required deployment variable. The staging
# hostname has not been assigned yet and is deliberately not invented here.
# Whatever you put in it must match, exactly:
#   * nginx  server_name  in /etc/nginx/sites-available/vmr-staging.conf
#   * VMR_HEALTH_HOST     in /etc/vmr/deploy.conf
# vmr-deploy refuses to run when those disagree, because a mismatch produces a
# blanket 400 that looks like an application fault.
#
# JSON array syntax is required (pydantic-settings parses tuple-valued settings
# as JSON). Written compactly so it stays shell-safe; quoted for the same reason.
TRUSTED_HOSTS='["REPLACE_WITH_STAGING_DNS_NAME"]'

# Networks whose direct TCP peer may supply X-Forwarded-*. Loopback is correct
# for Nginx on this same host. Staging refuses 0.0.0.0/0 and ::/0.
#
# Pair this with --no-proxy-headers on the uvicorn command line (see
# deploy/systemd/vmr-web.service): uvicorn's own proxy-header handling is ON by
# default and would rewrite the peer address before the application's boundary
# ever sees it, silently disabling this allow-list.
TRUSTED_PROXY_CIDRS='["127.0.0.1/32","::1/128"]'

# HSTS is emitted by the APPLICATION, only when the scheme is known to be HTTPS.
# Nginx must not add its own - two headers is not twice as safe. Set 0 to
# suppress during an HTTPS rollout; that is the supported lever.
HSTS_MAX_AGE_SECONDS=31536000

# --- Request and upload ceilings --------------------------------------------
# Three limits, deliberately ordered  upload < request < proxy  so each layer's
# error is the right error rather than an accident of which fired first:
#
#   MAX_UPLOAD_BYTES   26214400  (25 MiB)  the reviewed product ceiling
#   MAX_REQUEST_BYTES  27262976  (26 MiB)  1 MiB of headroom
#   nginx client_max_body_size 28m         above both; backstops chunked bodies
#
# The headroom is not decoration. A multipart upload declares the file PLUS its
# form framing (measured 230-269 bytes for this route). Setting the global
# request ceiling equal to the upload ceiling makes that framing tip a
# maximum-size upload over the global limit, so the caller gets the generic
# 413 {"error":"request_too_large"} from the hardening middleware instead of the
# application's own explanatory message - and the friendly message becomes
# unreachable over HTTP. Startup permits the equality; do not use it.
MAX_UPLOAD_BYTES=26214400
MAX_REQUEST_BYTES=27262976

# --- Database ---------------------------------------------------------------
# Full SQLAlchemy URL, consumed by Settings.database_url.
#
# TOPOLOGY - READ THIS BEFORE FILLING IT IN
# Staging startup REFUSES a loopback or container-service database host:
# 127.0.0.1, ::1, localhost, a bare Unix socket (empty host), the legacy numeric
# spellings of loopback, and the names postgres/db/database. That guard is
# deliberate and must not be relaxed.
#
# The supported topology is PostgreSQL on THIS VPS, reachable on a NON-LOOPBACK
# private address:
#
#   * postgresql.conf : listen_addresses includes that private address
#   * pg_hba.conf     : scoped to that address and the vmr_staging role only
#   * host firewall   : TCP/5432 DENIED from the public Internet - the private
#                       address must not be reachable off-box
#
# The guard exists to stop staging pointing at a developer machine or a container
# default. A dedicated, firewalled staging database on a private address
# satisfies both its letter and its intent; a hosts-file alias pointing back at
# 127.0.0.1 would satisfy neither and must not be used.
#
# REPLACE_WITH_PRIVATE_DB_ADDRESS is a required deployment variable. The address
# depends on this host's interfaces and is deliberately not invented here.
#
# The password is generated ON THE SERVER with `openssl rand -hex 32` (hex, so it
# needs no percent-encoding inside the URL) and written straight into the real
# file. It is never echoed, never passed in argv, never in shell history.
#
#   DATABASE_URL='postgresql+psycopg://vmr_staging:<generated>@REPLACE_WITH_PRIVATE_DB_ADDRESS:5432/vmr_staging'
DATABASE_URL=

# Connection and readiness bounds, in seconds.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=2

# --- Hosted-operator authentication (REQUIRED in staging) -------------------
# The application refuses to start in staging without a complete boundary. This
# is deliberate: without it, every operator surface and every campaign write
# endpoint is reachable by anyone who can resolve the hostname.
#
# Enable the boundary.
AUTH__ENABLED=true

# Signing secret for the session cookie, the CSRF token and the sign-in
# transaction. At least 32 characters. Generate ON THE SERVER and never commit:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH__SESSION_SECRET=

# The Google OAuth 2.0 Web application client for VMR APPLICATION IDENTITY ONLY.
# Identity scopes (openid/email/profile). This is NOT a Gmail grant and must
# never be reused as one. See docs/HOSTED_AUTH.md for the Console values.
AUTH__GOOGLE_CLIENT_ID=
AUTH__GOOGLE_CLIENT_SECRET=

# The single platform administrator. Created idempotently at each start with the
# ADMIN role and NO password, and never inferred from an email domain. This is the
# account that then creates everyone else at /app/admin/users. Startup refuses an
# empty value: a hosted deployment with no administrator cannot create the first
# one.
AUTH__BOOTSTRAP_ADMIN_EMAIL=sahil@verifiedmarketresearch.com

# LEGACY SEED, not an access gate (changed by #270). Access is granted by a row in
# the `users` table. Every address here that has no account gets one created at
# startup (role USER, active, no password), so the operators who could sign in
# before the accounts migration can still sign in after it. It may be left empty
# on a fresh deployment. Removing an address here revokes NOTHING — disable the
# account on the admin screen, which refuses that person's existing session on
# their next request with no restart.
AUTH__ALLOWED_OPERATOR_EMAILS=["REPLACE_WITH_OPERATOR_EMAIL"]

# The canonical external origin. MUST be https, MUST equal the same DNS name used
# in TRUSTED_HOSTS, the nginx server_name and VMR_HEALTH_HOST, and MUST match the
# redirect URI registered in Google Cloud Console byte for byte.
AUTH__PUBLIC_BASE_URL=https://REPLACE_WITH_STAGING_DNS_NAME

# Optional extra gate on top of the list above.
# AUTH__ALLOWED_GOOGLE_DOMAIN=

# Secure cookies are mandatory here; startup refuses false.
AUTH__COOKIE_SECURE=true

# --- Operator UI (optional in staging, and only with the boundary above) -----
# FEATURES__WORKBENCH=true mounts /app and /admin. It is now permitted in
# staging, but ONLY behind the complete boundary above - the startup contract
# refuses every partial combination. Leave it unset to run staging as an API-only
# deployment; the API is protected either way.
# FEATURES__WORKBENCH=true

# --- Chrome capture extension (optional; needed for hosted capture) ----------
# A VMR application bearer credential that lets ONE approved Chrome extension
# install submit captures. It is NOT the operator session cookie above, NOT a
# Google token, and NOT a Gmail grant, and an operator session does not
# authorise a capture in its place. It authorises one narrow intake contract
# (POST /api/intake/contact-captures plus three reads) and nothing else.
#
# Leave the whole block unset to run staging with no capture intake at all.
# Setting it requires FEATURES__CONTACT_CAPTURE_INTAKE and OPERATOR_BASE_URL
# below; the startup contract refuses every partial combination. Production
# refuses it outright.
#
# See docs/HOSTED_AUTH.md section 7a for issuing, approving and revoking.
# EXTENSION_AUTH__ENABLED=true
#
# Mint with: python scripts/mint_extension_credential.py --key-id <label>
# It prints the credential (pasted once into the extension) and this digest
# entry. The server never stores anything replayable.
# EXTENSION_AUTH__CREDENTIALS=["REPLACE_WITH_KEY_ID:REPLACE_WITH_SHA256_HEX"]
#
# Revocation. A key id here is refused even if still listed above.
# EXTENSION_AUTH__REVOKED_KEY_IDS=[]
#
# The exact extension origins allowed to present a credential. The install
# shows its own id in the extension's Settings screen. Exact match only.
# EXTENSION_AUTH__ALLOWED_ORIGINS=["chrome-extension://REPLACE_WITH_EXTENSION_ID"]
#
# The capture intake route itself. Refused outside local development UNLESS the
# extension credential boundary above is configured - that replaced the old
# blanket "local only" rule. The other intake switches did not move.
# FEATURES__CONTACT_CAPTURE_INTAKE=true

# --- Runtime ----------------------------------------------------------------
# Loopback port the application binds to and nginx proxies to. Must match the
# upstream in the nginx site.
APP_PORT=8000

# Staged uploads for the preview -> confirm import flow. MUST be absolute and
# MUST live under /srv/vmr/shared: the units run with ProtectSystem=strict and
# ReadWritePaths=/srv/vmr/shared, so the application's relative default
# (var/staged_uploads, resolved under the read-only release directory) would fail
# on first write. Created by /usr/local/sbin/vmr-provision.
STAGED_UPLOADS_DIR=/srv/vmr/shared/uploads

# --- Consumed by the systemd unit files, NOT by the application -------------
VMR_WORKER_CONCURRENCY=2
VMR_WORKER_POLL_SECONDS=2

# --- DELIBERATELY UNSET -----------------------------------------------------
# None of the following are configured, and none may be populated until the
# corresponding integration is explicitly authorised. Connecting any of these is
# a separate, approved decision - not a deployment step.
#
# OPERATOR_BASE_URL
#   Leave unset UNLESS hosted capture is enabled above. Its default is loopback,
#   and the four features that otherwise consume it (salesnav_intake,
#   linkedin_profile_intake, linkedin_company_intake, contact_capture_promotion)
#   are refused outright in staging. With hosted capture on, set it to this
#   deployment's own public origin so the capture response returns a link the
#   operator can actually open:
#     OPERATOR_BASE_URL=https://REPLACE_WITH_STAGING_DNS_NAME
#   The extension opens a returned link only for loopback or a named VMR
#   deployment, on a known workbench path, so a wrong value produces no link
#   rather than an off-site redirect.
#
# FEATURES__*
#   Every switch stays off by default. Two exceptions MAY now be set here, both
#   documented in their own blocks above: FEATURES__WORKBENCH (permitted in
#   staging only behind a complete AUTH__* boundary, refused outright in
#   production) and FEATURES__CONTACT_CAPTURE_INTAKE (permitted outside local
#   development only behind a configured EXTENSION_AUTH__* boundary). The
#   remaining local-only switches (salesnav, linkedin_profile, linkedin_company,
#   contact_capture_promotion) are still refused in staging by
#   validate_runtime_settings and must stay unset.
#
# CLAUDE_CLI_PATH
#   Only once a model Agent is switched on. The worker unit already provides a
#   deterministic PATH and HOME so the CLI can be found and can keep state
#   without an interactive shell; no credential is configured here.
#
# GMAIL_* / SHEETS_*
#   Mailbox authorization and Sheets are separate, unimplemented grants. Note
#   that AUTH__GOOGLE_CLIENT_ID/SECRET above are NOT these: they authenticate a
#   person to VMR and carry no mailbox scope. Do not reuse one client for both.
# MILLIONVERIFIER_API_KEY / LOGO_DEV_API_KEY
# PROVIDER_CREDENTIAL_ENCRYPTION_KEY
