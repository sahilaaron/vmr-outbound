# Shape of /etc/vmr/vmr.env on the staging server.
#
# ############################################################################
# THIS FILE CONTAINS NO VALUES AND MUST NEVER CONTAIN ANY.
# The real file lives ONLY on the server at /etc/vmr/vmr.env, mode 0640
# root:vmr, and is never committed, copied into the repository, or printed.
# ############################################################################
#
# Loaded by the systemd units via EnvironmentFile=. Keys are documented here so
# the deployment contract is reviewable without exposing the values.

# --- Database ---------------------------------------------------------------
# Full SQLAlchemy URL, as consumed by Settings.database_url (app/core/config.py).
# On staging the password is generated ON THE SERVER with `openssl rand -hex 32`
# (hex, so it needs no percent-encoding inside the URL) and written directly to
# /etc/vmr/vmr.env. It is never echoed, never passed in argv, never in history.
# Form:
#   DATABASE_URL=postgresql+psycopg://vmr_staging:<generated>@127.0.0.1:5432/vmr_staging
DATABASE_URL=

# --- Runtime ----------------------------------------------------------------
VMR_ENV=staging
# Loopback port the application binds to and nginx proxies to. Must match the
# upstream in the nginx site.
APP_PORT=8000

# --- Consumed by the systemd unit files, NOT by the application -------------
VMR_WORKER_CONCURRENCY=2
VMR_WORKER_POLL_SECONDS=2

# --- DELIBERATELY UNSET -----------------------------------------------------
# None of the following are configured, and none may be populated until the
# corresponding integration is explicitly authorised. Connecting any of these
# is a separate, approved decision - not a deployment step.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GMAIL_*=
# SHEETS_*=
# VERIFICATION_PROVIDER_API_KEY=
