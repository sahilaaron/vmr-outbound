      {"code": "europe", "label": "Europe", "aliases": ["emea europe", "european union", "eu"]},
      {"code": "middle-east", "label": "Middle East", "aliases": ["gcc", "gulf", "mena middle east"]},
      {"code": "africa", "label": "Africa", "aliases": ["sub saharan africa", "north africa"]},
      {"code": "asia-pacific", "label": "Asia-Pacific", "aliases": ["apac", "asia pacific"]},
      {"code": "south-asia", "label": "South Asia", "aliases": ["indian subcontinent", "india and neighbours"]},
      {"code": "east-asia", "label": "East Asia", "aliases": ["north east asia", "china japan korea"]},
      {"code": "southeast-asia", "label": "Southeast Asia", "aliases": ["asean", "south east asia"]},
      {"code": "oceania", "label": "Oceania", "aliases": ["australia and new zealand", "anz"]}
    ]
  }
}
